# Copy to .env next to compose.yml and fill in. Never commit .env.

# Signs song links. Make one with:  openssl rand -hex 32
MELODI_SECRET=

# Where browsers reach this server, and which site may call it.
MELODI_PUBLIC_URL=https://api.getmelodi.xyz
MELODI_ALLOWED_ORIGINS=https://app.getmelodi.xyz

# Song cache size in GB (keep some disk free).
MELODI_CACHE_GB=20

# From Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > token.
TUNNEL_TOKEN=

# Only if YouTube starts asking the server to "confirm you're not a bot":
# MELODI_YTDLP_ARGS=--cookies /data/cookies.txt
