# Cloudflare Pages response headers for the web app.
# The service worker and manifest must always be re-checked, or a deploy
# could stay invisible; hashed assets never change.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
