{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melodi",
  "version": "0.6.0",
  "identifier": "com.melodi.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melodi",
        "width": 1220,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0b0907"
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; img-src 'self' https: data:; media-src 'self' https: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
      "csp": "default-src 'self'; img-src 'self' https: data:; media-src 'self' https: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Melodi",
    "shortDescription": "Ad-free desktop music client",
    "category": "Music",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0QkRBMjQxOUQzODAyNkQKUldSdEFqaWRRYUs5cEkybDgyYTVjam1iZHBHdHM2T0tVdE4wTC9hUWZWd0NjSHoxZDNsdHVQR2cK",
      "endpoints": [
        "https://github.com/nixxane/melodi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
